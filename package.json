    "scratch-card",
    "slot-machine",
    "roulette",
    "pachinko",
    "blackjack",
    "poker",
    "texas-holdem",
    "web-components",
    "lit",
    "react",
    "vue",
    "angular",
    "typescript"
  ],
  "homepage": "https://adiakys.github.io/feeling-lucky/",
  "bugs": {
    "url": "https://github.com/Adiakys/feeling-lucky/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adiakys/feeling-lucky.git"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/feeling-lucky.js",
  "module": "./dist/feeling-lucky.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/feeling-lucky.js"
    }
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
