{
  "name": "feeling-lucky",
  "version": "0.1.0",
  "description": "A casino room for any web app: classic casino games that award the prizes you configure.",
  "keywords": [
    "casino",
    "games",
    "prizes",
    "gamification",
    "web-components",
    "lit"
  ],
  "homepage": "https://github.com/Adiakys/feeling-lucky#readme",
  "bugs": {
    "url": "https://github.com/Adiakys/feeling-lucky/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adiakys/feeling-lucky.git"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/feeling-lucky.js",
  "module": "./dist/feeling-lucky.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/feeling-lucky.js"
    }
  },
  "scripts": {
    "dev": "vite playground",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "build:demo": "vite build --config vite.demo.config.ts"
  },
  "devDependencies": {
    "@lit/context": "^1.1.6",
    "@playwright/test": "^1.49.1",
    "happy-dom": "^21.0.4",
    "lit": "^3.3.3",
    "lucide": "^1.61.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
