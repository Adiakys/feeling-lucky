{
  "name": "feeling-lucky",
  "version": "0.1.0",
  "description": "A casino room for any web app: classic casino games that award the prizes you configure.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/feeling-lucky.js",
  "module": "./dist/feeling-lucky.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/feeling-lucky.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite playground",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "happy-dom": "^21.0.4",
    "lit": "^3.3.3",
    "lucide": "^1.61.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
